# FrameDrop — environment configuration
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# Values shown are the built-in defaults.

# --- Server -----------------------------------------------------------------

# Bind address. Use 127.0.0.1 for local dev, 0.0.0.0 to expose (Docker/servers).
RECAST_HOST=127.0.0.1

# Port to listen on.
RECAST_PORT=8000

# --- SEO / public URL -------------------------------------------------------

# Your public site URL, WITHOUT a trailing slash. Used for canonical links,
# Open Graph / Twitter tags, sitemap.xml, robots.txt, and llms.txt.
# IMPORTANT: set this to your real domain in production, e.g. https://framedrop.app
RECAST_SITE_URL=https://framedrop.app

# --- Limits & concurrency ---------------------------------------------------

# Maximum upload size in BYTES (default 4 GiB = 4294967296).
RECAST_MAX_UPLOAD=4294967296

# Number of conversions to run at once. Scale to your CPU cores.
RECAST_MAX_WORKERS=2
